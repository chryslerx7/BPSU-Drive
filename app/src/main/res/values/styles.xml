<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.BPSU.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/bpsu_maroon</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/auth_button_radius</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/auth_button_height</item>
    </style>

    <style name="Widget.BPSU.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/stroke_grey</item>
        <item name="android:textColor">@color/bpsu_maroon</item>
        <item name="cornerRadius">@dimen/auth_button_radius</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/auth_button_height</item>
        <item name="backgroundTint">@color/white</item>
    </style>

    <style name="Widget.BPSU.Button.Tertiary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/chip_grey_bg</item>
        <item name="android:textColor">@color/chip_grey_text</item>
        <item name="cornerRadius">@dimen/auth_button_radius</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/auth_button_height</item>
    </style>

    <style name="Widget.BPSU.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/stroke_grey</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="TextAppearance.BPSU.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/auth_title_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.BPSU.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/auth_subtitle_size</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.BPSU.Note" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/auth_note_size</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.BPSU.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.BPSU.Chip" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.BPSU.Input.Error" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/error_red</item>
        <item name="hintTextColor">@color/error_red</item>
        <item name="android:textColorHint">@color/error_red</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="TextAppearance.BPSU.Error" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/error_red</item>
    </style>
</resources>
